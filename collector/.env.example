# Cloudflare Worker ingestion endpoint
INGEST_URL=https://albion-market-tool.yuudaiy0819.workers.dev/internal/market-feed/batch
# Configure as a secret in the collector host; never commit a real token.
INGEST_TOKEN=replace-with-a-long-random-token

# AODP Asia public NATS feed
NATS_SERVERS=nats://public:thenewalbiondata@nats.albion-online-data.com:24222

BATCH_SIZE=100
FLUSH_INTERVAL_MS=1500
MAX_QUEUE=20000
SPOOL_FILE=/data/queue.jsonl
